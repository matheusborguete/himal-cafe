# Copie este arquivo para .env e preencha. O .env NUNCA vai para o GitHub.
# No GitHub Actions, os mesmos nomes vão em Settings → Secrets and variables → Actions.

# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=

# @BotFather no Telegram → /newbot
TELEGRAM_BOT_TOKEN=
# Deixe vazio, rode "npm run verificar" depois de mandar um oi ao bot e ele te responde o número
TELEGRAM_CHAT_ID=

# Token de longa duração do Instagram (Meta for Developers → app → Instagram → Gerar token)
IG_TOKEN=
